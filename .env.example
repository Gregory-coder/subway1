# Pool wallet address
POOL_WALLET_ADDRESS=YOUR_POOL_WALLET_ADDRESS

# PostgreSQL
POSTGRES_USER=pool
POSTGRES_PASSWORD=poolpassword
POSTGRES_DB=xmr_pool

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Monero Daemon RPC
DAEMON_RPC_HOST=monerod
DAEMON_RPC_PORT=18081
DAEMON_RPC_USER=
DAEMON_RPC_PASSWORD=

# Monero Wallet RPC
WALLET_RPC_HOST=monero-wallet-rpc
WALLET_RPC_PORT=18082
WALLET_RPC_USER=rpc_user
WALLET_RPC_PASSWORD=rpc_password

# Stratum
STRATUM_PORT=3333

# API
API_PORT=8080
